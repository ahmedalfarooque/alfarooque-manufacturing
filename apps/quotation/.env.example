# Quotation App — environment variables
# Copy to .env.local (git-ignored) and fill in real values before running
# `npm run dev` or deploying. See ERP_DEPLOYMENT.md at the repo root for
# where each value comes from.

# --- Supabase (same project as every other ERP app) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
# Shared across all 6 apps — must be IDENTICAL in every app's env so the
# af_sso_session cookie can be verified by any of them.
JWT_SECRET=
SSO_JWT_SECRET=
# Parent domain for the shared SSO cookie in production (omit on localhost).
AF_COOKIE_DOMAIN=

# --- Sibling app URLs (Application Switcher) ---
NEXT_PUBLIC_QUOTATION_APP_URL=
NEXT_PUBLIC_PROJECTS_APP_URL=
NEXT_PUBLIC_CARS_APP_URL=
NEXT_PUBLIC_INVENTORY_APP_URL=
NEXT_PUBLIC_ACCOUNTING_APP_URL=
NEXT_PUBLIC_CRM_APP_URL=
# Server-side (non-public) copy used by API routes that call Projects directly.
PROJECTS_APP_URL=

# --- Company profile (used in the quotation PDF document + reports) ---
NEXT_PUBLIC_COMPANY_NAME_EN=ALFAROOQUE WOOD WORKS FACTORY
NEXT_PUBLIC_COMPANY_NAME_AR=مصنع الفاروق للأعمال الخشبية
NEXT_PUBLIC_COMPANY_ADDRESS_EN=Bahara, Jeddah, Saudi Arabia
NEXT_PUBLIC_COMPANY_ADDRESS_AR=بحرة، جدة، المملكة العربية السعودية
NEXT_PUBLIC_COMPANY_CR=4031098279
NEXT_PUBLIC_COMPANY_VAT=312048700900003
NEXT_PUBLIC_COMPANY_PHONE=0564466661
NEXT_PUBLIC_COMPANY_EMAIL=chairman@alfarooque.com
NEXT_PUBLIC_COMPANY_WEBSITE=

# --- Outbound email (OTP codes, quotation notifications) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@alfarooque.com
EMAIL_TO=

# --- PDF generation (server-rendered via headless Chrome) ---
# On Vercel this is auto-detected — do not set manually in production.
# Only needed for local dev on some Linux distros if Chromium isn't found.
PUPPETEER_EXECUTABLE_PATH=

# --- Scheduled jobs ---
# Shared secret checked by any cron-triggered API route (quote expiry
# sweeps, etc.) so it can't be called by the public internet.
CRON_SECRET=
